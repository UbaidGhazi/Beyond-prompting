# Google Gemini API Key(s)
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
# Copy this file to .env and replace placeholders with your actual key(s):
# cp .env.example .env

# Primary API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Secondary API Key (Automatic failover if primary key hits rate/quota limits)
GEMINI_API_KEY_2=your_second_gemini_api_key_here

# Comma-separated keys for multi-key automatic rotation
GEMINI_API_KEYS=your_gemini_api_key_here,your_second_gemini_api_key_here

# Configurable Gemini Model (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
